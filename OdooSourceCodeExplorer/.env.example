# Trusted Bash configuration. Copy to .env.local and chmod 600 .env.local.
COPILOT_GITHUB_TOKEN=''
SourceRepository__Path='/Users/your-name/dev/odoo'
APPLICATION_VERSION='odoo-poc-subset'
INDEX_PATHS=(
  'addons/sale/models/sale_order.py'
  'addons/stock/models/stock_picking.py'
  'addons/sale_stock/models/sale_order.py'
  # 'addons/sale'  # Directories include tracked Python files recursively.
)
DEMO_ROOT="$HOME/BusinessChatDemo"
Retrieval__OllamaUrl='http://localhost:11434/'
Retrieval__QdrantUrl='http://localhost:6333/'
Retrieval__EmbeddingModel='nomic-embed-text:v1.5'
# Optional native Qdrant; otherwise use the repository's Docker Compose service.
# QDRANT_BINARY='/absolute/path/to/qdrant'
# QDRANT_CONFIG='/absolute/path/to/local.yaml'
# QDRANT_WORKDIR='/absolute/path/to/qdrant-data-directory'
# Optional local embedding download during preparation (never during runtime).
PULL_EMBEDDING_MODEL=1
RETRIEVAL_TEST_QUESTION='Can I cancel a locked sales order?'
# WEB_URL='http://localhost:5112'
